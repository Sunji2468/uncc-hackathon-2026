DATABASE_URL=postgresql://tasteheist:tasteheist@localhost:5432/tasteheist
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
USDA_API_KEY=
AI_DAILY_LIMIT=40        # AI calls per user per day
DEMO_MODE=false          # true = never call the AI, serve fixtures
APP_SECRET=             # random string; signs swap suggestions (openssl rand -hex 32)
SIGNUPS_PER_HOUR=10      # sign-ups per IP per hour; raise only for test servers
YOUTUBE_API_KEY=         # optional: YouTube Data API v3 recipe recommendations
